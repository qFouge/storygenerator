# Copy to .env (git-ignored) and fill in. Never commit a real key.
#
# Load it into your shell before running:
#   set -a; . ./.env; set +a
ELEVENLABS_API_KEY=sk_...
GEMINI_API_KEY=...

# The ElevenLabs key only needs the speech-synthesis scope (this pipeline calls
# POST /v1/text-to-dialogue and nothing else). Set a per-key credit limit too.
# See the Security section of the README.
